{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "StepUnder",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "recommends": [
          "libmpv2 | libmpv1",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "gnome-keyring"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
