{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StepUnder",
  "version": "0.2.2",
  "identifier": "com.stepz.stepunder",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StepUnder",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,SpareRendererForSitePerProcess,AudioServiceOutOfProcess --renderer-process-limit=1 --disable-background-networking --disable-component-update --disable-extensions --disable-default-apps --disable-sync --no-pings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Thai", "English"],
        "customLanguageFiles": {
          "Thai": "windows/thai.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3MjhBMUNERjZFRUJGQTkKUldTcHYrNzJ6YUVvMTNYUVM5ai9zc2NxcDhVSUkwaWpTU2dmck9JYjk4aGVYNXBqRlJabmdsNVMK",
      "endpoints": [
        "https://github.com/Steper158X/StepUnder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
